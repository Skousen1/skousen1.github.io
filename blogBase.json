{"singlePage": [], "startSite": "", "filingNum": "", "onePageListNum": 15, "commentLabelColor": "#006b75", "yearColorList": ["#bc4c00", "#0969da", "#1f883d", "#A333D0"], "i18n": "CN", "themeMode": "manual", "dayTheme": "light", "nightTheme": "dark", "urlMode": "pinyin", "script": "", "style": "", "head": "", "indexScript": "", "indexStyle": "", "bottomText": "", "showPostSource": 1, "iconList": {}, "UTC": 8, "rssSplit": "sentence", "exlink": {}, "needComment": 1, "allHead": "<link rel=\"canonical\" href=\"https://tghaocc.github.io/\">\n<meta name=\"robots\" content=\"index, follow\">\n<meta property=\"og:type\" content=\"website\">\n<meta property=\"og:title\" content=\"\u79d1\u6280\u5c9b - \u514d\u8d39\u82f9\u679cID\u5171\u4eab_\u7f8e\u533a\u65e5\u533aAppleID\u4e0e\u5c0f\u706b\u7bad\u8d26\u53f7\u83b7\u53d6\">\n<meta property=\"og:description\" content=\"\u79d1\u6280\u5c9b\u662f\u4e13\u4e1a\u76842026\u514d\u8d39\u82f9\u679cID\u5171\u4eab\u4e0e\u6d77\u5916AppleID\u83b7\u53d6\u5e73\u53f0\u3002\u6bcf\u65e5\u5b9e\u65f6\u66f4\u65b0\u7a33\u5b9a\u53ef\u7528\u7684\u7f8e\u533a\u3001\u65e5\u533a\u3001\u6e2f\u533a\u82f9\u679c\u8d26\u53f7\u53ca\u5bc6\u7801\uff0c\u4e00\u7ad9\u5f0f\u89e3\u51b3App Store\u9501\u533a\u3001\u53cc\u91cd\u8ba4\u8bc1\uff082FA\uff09\u53caShadowrocket\uff08\u5c0f\u706b\u7bad\uff09\u4e0b\u8f7d\u96be\u9898\u3002\">\n<meta property=\"og:url\" content=\"https://tghaocc.github.io/\">\n<style>\n/* \ud83c\udf1f 1. \u5de6\u4e0a\u89d2\u54c1\u724c\u80f6\u56ca */\n.pro-brand-capsule {\n    position: relative;\n    overflow: hidden;\n    display: inline-flex !important;\n    align-items: center;\n    padding: 10px 20px !important;\n    background: linear-gradient(135deg, rgba(255, 255, 255, 0.98) 0%, rgba(246, 240, 255, 0.95) 100%) !important;\n    border: 2px solid rgba(147, 112, 219, 0.45) !important;\n    border-radius: 30px !important;\n    box-shadow: 0 10px 28px rgba(138, 43, 226, 0.12), inset 0 1px 2px rgba(255, 255, 255, 0.9) !important;\n    text-decoration: none !important;\n    backdrop-filter: blur(16px);\n    margin-bottom: 12px;\n}\n\n.pro-brand-capsule img, .pro-brand-capsule .avatar {\n    width: 48px !important;\n    height: 48px !important;\n    border-radius: 14px !important;\n    object-fit: cover;\n    margin-right: 12px !important;\n    border: 1px solid rgba(147, 112, 219, 0.2);\n}\n\n.pro-brand-text {\n    display: flex;\n    flex-direction: column;\n    line-height: 1.25;\n}\n\n.pro-brand-title {\n    font-size: 20px !important;\n    font-weight: 800 !important;\n    background: linear-gradient(135deg, #7b2cbf 0%, #3a86ff 100%);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n}\n\n.pro-brand-subtitle {\n    font-size: 10px !important;\n    font-weight: 700 !important;\n    color: #6c757d !important;\n    letter-spacing: 2.2px;\n    margin-top: 3px;\n    text-transform: uppercase;\n}\n\n/* \ud83c\udf1f 2. \u5f3a\u529b\u7834\u754c\uff1a\u8ba9\u7cfb\u7edf\u516c\u544a\u5361\u7247 100% \u5360\u6ee1\u6574\u4e2a\u5c4f\u5e55\u6a2a\u5411\u5bbd\u5ea6 */\n.pro-notice-card {\n    position: relative !important;\n    left: 50% !important;\n    right: 50% !important;\n    margin-left: -50vw !important;\n    margin-right: -50vw !important;\n    width: 100vw !important;\n    box-sizing: border-box !important;\n    background: linear-gradient(135deg, #1e1b4b 0%, #312e81 50%, #151c2f 100%) !important;\n    border-top: 1.5px solid rgba(167, 139, 250, 0.4) !important;\n    border-bottom: 1.5px solid rgba(167, 139, 250, 0.4) !important;\n    border-radius: 0 !important;\n    padding: 20px 20px !important;\n    margin-top: 10px !important;\n    margin-bottom: 24px !important;\n    box-shadow: 0 12px 35px rgba(30, 27, 75, 0.3) !important;\n    color: #f1f5f9 !important;\n}\n\n.pro-notice-header {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    margin-bottom: 10px;\n}\n\n.pro-notice-badge1 {\n    background: linear-gradient(135deg, #7c3aed, #4f46e5);\n    color: #fff;\n    font-size: 11px;\n    font-weight: 700;\n    padding: 3px 10px;\n    border-radius: 6px;\n}\n\n.pro-notice-badge2 {\n    background: rgba(255, 255, 255, 0.12);\n    color: #c084fc;\n    font-size: 11px;\n    font-weight: 600;\n    padding: 3px 8px;\n    border-radius: 6px;\n}\n\n.pro-notice-body {\n    font-size: 14px !important;\n    line-height: 1.85 !important;\n    color: #cbd5e1 !important;\n}\n\n/* \u9690\u85cf\u539f\u5148\u7cfb\u7edf\u81ea\u5e26\u7684\u5197\u4f59\u6b22\u8fce\u8bed */\n.subTitle {\n    display: none !important;\n}\n</style>\n\n<script>\ndocument.addEventListener(\"DOMContentLoaded\", function() {\n    let originalAvatar = document.getElementById(\"avatarImg\") || document.querySelector(\".avatar\");\n    if (originalAvatar && !document.getElementById(\"proBrandCapsule\")) {\n        let capsule = document.createElement(\"a\");\n        capsule.id = \"proBrandCapsule\";\n        capsule.href = \"https://tghaocc.github.io\";\n        capsule.className = \"pro-brand-capsule\";\n        \n        let avatarSrc = originalAvatar.src || \"https://raw.githubusercontent.com/tghaocc/tghaocc.github.io/refs/heads/main/IMG_4794.png\";\n        let textDiv = document.createElement(\"div\");\n        textDiv.className = \"pro-brand-text\";\n        textDiv.innerHTML = '<span class=\"pro-brand-title\">\u79d1\u6280\u5c9b</span><span class=\"pro-brand-subtitle\">GLOBAL STORE</span>';\n        \n        let imgElem = document.createElement(\"img\");\n        imgElem.src = avatarSrc;\n        imgElem.className = \"avatar\";\n        \n        let parent = originalAvatar.parentNode;\n        parent.insertBefore(capsule, originalAvatar);\n        originalAvatar.remove();\n        \n        capsule.appendChild(imgElem);\n        capsule.appendChild(textDiv);\n    }\n\n    let capsuleElem = document.getElementById(\"proBrandCapsule\");\n    if (capsuleElem && !document.getElementById(\"proNoticeCard\")) {\n        let noticeCard = document.createElement(\"div\");\n        noticeCard.id = \"proNoticeCard\";\n        noticeCard.className = \"pro-notice-card\";\n        noticeCard.innerHTML = `\n            <div class=\"pro-notice-header\">\n                <span class=\"pro-notice-badge1\">\ud83d\udce2 \u7cfb\u7edf\u516c\u544a</span>\n                <span class=\"pro-notice-badge2\">\u5e73\u53f0\u6307\u5357</span>\n            </div>\n            <div class=\"pro-notice-body\">\n                \u6b22\u8fce\u6765\u5230\u79d1\u6280\u5c9b\uff01\u6211\u4eec\u957f\u671f\u4e3a\u60a8\u63d0\u4f9b\u7a33\u5b9a\u3001\u5b89\u5168\u7684\u7f8e\u533a\u3001\u6e2f\u533a\u3001\u65e5\u533a App Store \u8d26\u53f7\u4e0e\u6d77\u5916 Apple ID \u83b7\u53d6\u6307\u5357\u3002\u5728\u8fd9\u91cc\uff0c\u60a8\u53ef\u4ee5\u8f7b\u677e\u83b7\u53d6\u5b9e\u65f6\u66f4\u65b0\u7684\u5171\u4eab\u8d26\u53f7\uff0c\u5e76\u89e3\u51b3 iOS \u9501\u533a\u3001\u53cc\u91cd\u8ba4\u8bc1\uff082FA\uff09\u53ca\u8f6f\u4ef6\u4e0b\u8f7d\u7b49\u5e38\u89c1\u95ee\u9898\uff0c\u4e00\u7ad9\u5f0f\u89e3\u9501\u5168\u7403\u7cbe\u5f69\u5e94\u7528\u4e0e\u6e38\u620f\u3002\n            </div>\n        `;\n        capsuleElem.parentNode.insertBefore(noticeCard, capsuleElem.nextSibling);\n    }\n\n    document.querySelectorAll(\".subTitle\").forEach(el => el.style.display = \"none\");\n});\n</script>", "title": "\u79d1\u6280\u5c9b - \u514d\u8d39\u82f9\u679cID\u5171\u4eab_\u7f8e\u533a\u65e5\u533aAppleID\u4e0e\u5c0f\u706b\u7bad\u8d26\u53f7\u83b7\u53d6", "subTitle": "\u6b22\u8fce\u6765\u5230\u79d1\u6280\u5c9b\uff01", "description": "\u79d1\u6280\u5c9b\u662f\u4e13\u4e1a\u76842026\u514d\u8d39\u82f9\u679cID\u5171\u4eab\u4e0e\u6d77\u5916AppleID\u83b7\u53d6\u5e73\u53f0\u3002\u6bcf\u65e5\u5b9e\u65f6\u66f4\u65b0\u7a33\u5b9a\u53ef\u7528\u7684\u7f8e\u533a\u3001\u65e5\u533a\u3001\u6e2f\u533a\u82f9\u679c\u8d26\u53f7\u53ca\u5bc6\u7801\uff0c\u4e00\u7ad9\u5f0f\u89e3\u51b3App Store\u9501\u533a\u3001\u53cc\u91cd\u8ba4\u8bc1\uff082FA\uff09\u53caShadowrocket\uff08\u5c0f\u706b\u7bad\uff09\u4e0b\u8f7d\u96be\u9898\uff0c\u5b8